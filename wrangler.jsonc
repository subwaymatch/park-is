{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "park-is",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // The vinext app, plus byte-range serving for the videos in /media.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    // Prerendered pages live in static assets as private cache entries, so
    // requests go through the Worker first. Hashed build output is served directly.
    "run_worker_first": ["/*", "!/_next/static/*"]
  },
  // Workers Builds runs `wrangler preview` for non-production branches, which
  // requires this block. Empty: Previews use the top-level settings.
  "previews": {},
  "observability": { "enabled": true }
}
