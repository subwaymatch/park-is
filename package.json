    "vinext": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
